# market-pilot-site
DirectoryIndex index.php
Options -Indexes
<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>
RewriteEngine On
RewriteRule ^(?:core|site|public|inc|locales|tools|docs|config|storage|scripts|tests|data-import)(?:/|$) - [F,L]
RewriteRule ^yardimci-asistan/(?:config|data|lib|knowledge)(?:/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<FilesMatch "(^\.|\.(?:md|sh|bak)$)">
  Require all denied
</FilesMatch>
