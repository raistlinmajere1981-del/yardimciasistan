{
  "$schema": "https://unpkg.com/knip/schema.json",
  "tags": ["-compiledSmoke"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{js,mjs,cjs,ts}"
      ],
      "project": [
        "scripts/**/*.{js,mjs,cjs,ts}"
      ]
    },
    "apps/desktop-app": {
      "entry": [
        "electron/main-entry.ts",
        "electron/commerce-store.ts",
        "electron/commerce-runtime.ts",
        "scripts/**/*.{js,mjs,cjs,ts}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        "scripts/**/*.{js,mjs,cjs,ts}",
        "*.config.ts"
      ]
    },
    "packages/shared": {
      "project": ["**/*.ts"]
    },
    "packages/ai-core": {
      "project": ["**/*.ts"]
    },
    "packages/sync-core": {
      "project": ["**/*.ts"]
    },
    "packages/whatsapp-bridge": {
      "project": ["**/*.ts"]
    },
    "packages/web-widget": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
