{
  "$schema": "https://unpkg.com/knip/schema.json",
  "tags": [
    "-compiledSmoke"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{js,mjs,cjs,ts,tsx}"
      ],
      "project": [
        "scripts/**/*.{js,mjs,cjs,ts,tsx}"
      ]
    },
    "apps/admin-control-center": {
      "entry": [
        "electron/main.ts",
        "electron/preload.ts",
        "scripts/**/*.{js,mjs,cjs,ts}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        "shared/**/*.ts",
        "scripts/**/*.{js,mjs,cjs,ts}",
        "*.config.ts"
      ]
    },
    "apps/desktop-app": {
      "entry": [
        "electron/main-entry.ts",
        "electron/windows-native-bootstrap.ts",
        "electron/commerce-store.ts",
        "electron/commerce-runtime.ts",
        "scripts/**/*.{js,mjs,cjs,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "electron/**/*.ts",
        "scripts/**/*.{js,mjs,cjs,ts,tsx}",
        "*.config.ts"
      ]
    },
    "packages/shared": {
      "project": [
        "**/*.ts"
      ]
    },
    "packages/ai-core": {
      "project": [
        "**/*.ts"
      ]
    },
    "packages/sync-core": {
      "project": [
        "**/*.ts"
      ]
    },
    "packages/whatsapp-bridge": {
      "project": [
        "**/*.ts"
      ]
    },
    "test-site/landing": {
      "project": [
        "assistant/**/*.ts"
      ]
    }
  }
}
