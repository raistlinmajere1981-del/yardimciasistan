{
  "name": "@yardimci-asistan/admin-control-center",
  "version": "0.1.0",
  "private": true,
  "description": "Yardımcı Asistan geliştirici/yönetici kontrol merkezi.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "build": "tsc -p tsconfig.electron.json && vite build --config vite.renderer.config.ts",
    "build:check": "node scripts/build-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:credentials": "tsc -p tsconfig.electron.json && node --test ../../scripts/test-admin-credentials.mjs",
    "test:verification": "tsc -p tsconfig.electron.json && node --test ../../scripts/test-admin-verification-progress.mjs",
    "predev": "node scripts/sync-effect-studio.mjs",
    "prebuild": "node scripts/sync-effect-studio.mjs",
    "prebuild:check": "node scripts/sync-effect-studio.mjs --check",
    "effect:sync": "node scripts/sync-effect-studio.mjs",
    "effect:check": "node scripts/sync-effect-studio.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "vite": "^8.3.4"
  }
}
