# Copy this file to keystore.properties (git-ignored), or define the same
# names as environment variables / ~/.gradle/gradle.properties entries.
# Prefer an absolute path outside the repository.
YA_ANDROID_KEYSTORE_PATH=/secure/path/yardimci-asistan-release.jks
YA_ANDROID_KEYSTORE_PASSWORD=replace-with-store-password
YA_ANDROID_KEY_ALIAS=yardimci-asistan
YA_ANDROID_KEY_PASSWORD=replace-with-key-password
