<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme_Night" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/ya_night_background</item>
        <item name="android:colorAccent">@color/ya_night_accent</item>
        <item name="android:navigationBarColor">@color/ya_night_background</item>
        <item name="android:statusBarColor">@color/ya_night_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme_Day" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/ya_day_background</item>
        <item name="android:colorAccent">@color/ya_day_accent</item>
        <item name="android:navigationBarColor">@color/ya_day_background</item>
        <item name="android:statusBarColor">@color/ya_day_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
